# Copy to server/.env and fill values

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email & Mailer Configuration (Resend API or Custom SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Centroid CAT <onboarding@resend.dev>

# Optional Custom SMTP Server (used if RESEND_API_KEY is not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false

# OpenAI API Key for AI Translation & Glossary Services
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Server API Configuration
PORT=5000
